# ============================================================
# AdOps Command Center - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/adops.db

# Production (PostgreSQL) - uncomment and fill
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adops

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Google Ads API ---
# Get these from Google Cloud Console + Google Ads API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token-here
GOOGLE_ADS_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth2-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-mcc-customer-id   # MCC hesap ID (tiresiz)

# --- Demo Mode ---
# true = Google Ads API bağlantısı olmadan mock veriyle çalış
DEMO_MODE=true

# --- Email (Raporlar için) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=adops@youragency.com

# --- Sentry (Production hata takibi) ---
SENTRY_DSN=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- First Admin User (ilk çalıştırmada oluşturulur) ---
FIRST_ADMIN_EMAIL=admin@youragency.com
FIRST_ADMIN_PASSWORD=change-me-strong-password
